generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  B2B
}

enum PaymentMethod {
  WOMPI
  CASH_ON_DELIVERY
  WHATSAPP
  MERCADO_LIBRE
}

enum OrderStatus {
  PENDING
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingCarrier {
  ENVIA
  SERVIENTREGA
}

// ── Postventa ──────────────────────────────────────────────────────────────

enum PostSaleType {
  TRANSIT_DAMAGE // llego roto: transportadora o empaque
  CUSTOMER_DAMAGE // el cliente lo rompio
  EXCHANGE // cambio de color/modelo
  MISSING_ITEM // faltante en el pedido
  OTHER
}

enum PostSaleFault {
  NIMVU
  CUSTOMER
  UNDEFINED
}

/// Quien paga el envio del repuesto. CUSTOMER_TO_COURIER es plata que el
/// cliente si paga, pero que nunca pasa por la caja de Nimvu: se registra el
/// monto de forma informativa y no debe contarse como ingreso.
enum PostSaleShippingPayer {
  NIMVU
  CUSTOMER_TO_NIMVU
  CUSTOMER_TO_COURIER
}

enum PostSaleStatus {
  OPEN
  PREPARING
  SHIPPED
  RESOLVED
  CANCELLED
}

// ── Carrito abandonado ─────────────────────────────────────────────────────

/// Estado del seguimiento comercial del lead. CONVERTED no se escribe nunca:
/// la conversion se deduce comparando contra las ordenes reales del correo
/// (ver CheckoutLeadsService.findAll), asi un pago rechazado devuelve el lead
/// a la lista automaticamente.
enum CheckoutLeadStatus {
  OPEN
  CONTACTED
  LOST
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String?
  role                Role      @default(USER)
  // B2B Specifics
  companyName         String?
  taxId               String?
  isB2BApproved       Boolean   @default(false)
  // Password Reset
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  orders              Order[]
  addresses           Address[]
}

model Product {
  id              String         @id @default(uuid())
  name            String
  description     String?
  price           Float
  stock           Int
  images          String[]
  // Dimensions
  height          Float?
  width           Float?
  length          Float?
  // Rich Text Description
  longDescription String? // @db.Text is implied for String in Prisma unless specified otherwise, but for Postgres String is text.
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  isB2BOnly       Boolean        @default(false)
  isActive        Boolean        @default(true)
  slug            String?        @unique
  variants        Variant[]
  orderItems      OrderItem[]
  postSaleItems   PostSaleItem[]
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  universeId      String?
  universe        Universe?      @relation(fields: [universeId], references: [id])
  collections     Collection[]
  discountPrice   Float?
  discountEndDate DateTime?
  discounts       Discount[]
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Discount {
  id          String       @id @default(uuid())
  name        String
  code        String?      @unique // Null for campaigns, present for coupons
  type        DiscountType
  value       Float
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean      @default(true)
  usageLimit  Int? // Max uses for coupons
  usedCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]
  collections Collection[]
}

model Collection {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  image       String?
  isActive    Boolean    @default(true)
  slug        String     @unique
  products    Product[]
  discounts   Discount[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Variant {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  name       String
  stock      Int
  price      Float?
  images     String[]
  sku        String      @unique
  orderItems OrderItem[]
}

model Order {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  status            OrderStatus      @default(PENDING)
  total             Float
  paymentId         String?          @unique
  paymentMethod     PaymentMethod    @default(WOMPI)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  shippingAddress   Json?
  recoveryEmailSent Boolean          @default(false)
  shippingCarrier   ShippingCarrier?
  trackingNumber    String?
  items             OrderItem[]
  postSaleCases     PostSaleCase[]
}

/// Datos de contacto capturados en el checkout ANTES de que el cliente le de
/// click a pagar. Deliberadamente NO es una Order: no descuenta stock, no crea
/// usuario, no consume cupon y no aparece en las metricas de ventas. Existe
/// solo para poder cerrar la venta por WhatsApp.
model CheckoutLead {
  id              String             @id @default(uuid())
  /// Identificador del navegador. Es la clave del upsert: cada visitante deja
  /// un unico lead que se va enriqueciendo mientras llena el formulario, en vez
  /// de una fila por cada tecla.
  sessionId       String             @unique
  email           String
  phone           String?
  name            String?
  /// Snapshot de la direccion tal como la escribio el cliente.
  shippingAddress Json?
  /// Snapshot de los items con nombre y precio resueltos en el servidor.
  items           Json
  subtotal        Float              @default(0)
  /// userId si el cliente tenia sesion iniciada; null si venia como invitado.
  userId          String?
  status          CheckoutLeadStatus @default(OPEN)
  note            String?
  contactedAt     DateTime?
  /// Ultima vez que el cliente toco el checkout. Lo escribe solo la captura,
  /// nunca el admin: es la referencia para saber si la orden que vino despues
  /// corresponde a este intento o a una compra anterior del mismo correo.
  capturedAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, capturedAt])
  @@index([email])
}

model OrderItem {
  id          String   @id @default(uuid())
  productId   String
  orderId     String
  variantId   String?
  variantName String?
  quantity    Int
  price       Float
  product     Product  @relation(fields: [productId], references: [id])
  variant     Variant? @relation(fields: [variantId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  street    String
  city      String
  state     String
  zip       String
  country   String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String?
  description String?
  image       String?
  order       Int       @default(0)
  products    Product[]
  universeId  String?
  universe    Universe? @relation(fields: [universeId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([universeId, name])
  @@unique([universeId, slug])
}

model Universe {
  id             String     @id @default(uuid())
  name           String     @unique
  slug           String     @unique
  description    String?
  icon           String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  order          Int        @default(0)
  isActive       Boolean    @default(true)
  comingSoon     Boolean    @default(false)
  categories     Category[]
  banners        Banner[]
  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Banner {
  id              String    @id @default(uuid())
  universeId      String?
  universe        Universe? @relation(fields: [universeId], references: [id])
  image           String
  mobileImage     String?
  badge           String?
  title           String
  subtitle        String?
  ctaText         String?
  ctaHref         String?
  textColor       String?
  badgeColor      String?
  titleColor      String?
  subtitleColor   String?
  accentLineColor String?
  ctaBgColor      String?
  ctaTextColor    String?
  order           Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum ExpenseCategory {
  FILAMENT
  PACKAGING
  ADVERTISING
  SHIPPING
  TOOLS
  MAINTENANCE
  SOFTWARE
  OTHER
}

model Expense {
  id          String          @id @default(uuid())
  description String
  amount      Float
  category    ExpenseCategory
  date        DateTime
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Parametros con los que se costea un producto impreso en 3D.
///
/// Es una fila unica (id fijo "default"): el negocio tiene un solo juego de
/// costos vigente, y tenerlos aqui y no en el codigo permite que suban el
/// filamento o la luz sin tocar un deploy.
model PricingSettings {
  id String @id @default("default")

  /// COP por kilo de filamento, tal como se compra el rollo.
  filamentPricePerKg Float @default(80000)
  /// Fraccion de material que se pierde en fallos y purga (0.06 = 6%).
  /// Va sobre el material y no como costo fijo porque una pieza grande que
  /// falla desperdicia mucho mas que una pequena.
  wastePercent       Float @default(0.06)

  /// Consumo medio de la impresora mientras imprime, en vatios.
  printerWatts      Float @default(120)
  /// COP por kWh de la factura.
  energyPricePerKwh Float @default(950)

  /// Lo que costo la impresora y cuantas horas de impresion se espera que dure.
  /// De aqui sale la depreciacion por hora, que pesa bastante mas que la luz.
  printerCost      Float @default(3000000)
  printerLifeHours Float @default(5000)

  /// COP por hora de trabajo manual: quitar soportes, lijar, armar, empacar.
  laborPricePerHour Float @default(15000)

  /// Empaque y consumibles que no dependen del tamano de la pieza.
  packagingCost Float @default(2000)

  /// Margen objetivo SOBRE EL PRECIO (0.5 = 50%), no un multiplicador sobre el
  /// costo: asi "quiero 50%" da 50% de verdad y se puede comparar contra lo que
  /// queda despues de la comision y del envio gratis.
  targetMargin Float @default(0.5)

  /// Comision de la pasarela, solo para mostrar el margen que queda de verdad.
  paymentFeePercent Float @default(0.0315)

  /// A cuanto se redondea hacia arriba el precio sugerido.
  roundingStep Float @default(500)

  updatedAt DateTime @updatedAt
}

model ShippingRate {
  id        String   @id @default(uuid())
  country   String
  state     String?
  city      String?
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, state, city]) // Ensure no duplicate rules for the same location combo
}

/// Caso de postventa sobre una orden ya entregada: roturas, cambios de color,
/// faltantes. Una orden puede acumular varios casos a lo largo del tiempo.
model PostSaleCase {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  type   PostSaleType
  fault  PostSaleFault  @default(UNDEFINED)
  status PostSaleStatus @default(OPEN)

  description String?

  // Envio del repuesto. shippingAmount se guarda tambien cuando paga el
  // domiciliario, aunque en ese caso no sea plata de Nimvu.
  shippingPayer   PostSaleShippingPayer?
  shippingAmount  Float?
  shippingCarrier ShippingCarrier?
  trackingNumber  String?

  items PostSaleItem[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([orderId])
}

/// Producto involucrado en un caso. En un cambio, `fromVariantName` es la
/// variante que el cliente tenia y `variantName` la que se le envio.
model PostSaleItem {
  id     String       @id @default(uuid())
  caseId String
  case   PostSaleCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantName     String?
  fromVariantName String?
  quantity        Int     @default(1)
  note            String?

  @@index([caseId])
}
